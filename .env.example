DB_HOST=
DB_PORT=3306
DB_USER=easystock_app
DB_PASSWORD=
DB_NAME=easystock
# Leave blank for local MySQL.
DB_SSL_CA=
PORT=3000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Time zone the market hours are evaluated in
MARKET_TZ=America/New_York

# development locally, production on EC2
NODE_ENV=development

# Dev only: allow trades outside market hours while testing
MARKET_ALWAYS_OPEN=false

# Random stock price generator (all optional)
# on by default; set to off to freeze prices (to test with postman)
PRICE_GENERATOR=on
# Milliseconds between price updates (minimum 1000)
PRICE_TICK_MS=5000
# 1 = realistic day. 2 or 3 makes prices move quicker (should be used for video)
PRICE_VOLATILITY=1